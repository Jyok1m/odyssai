// Schema de la base applicative.
//
// L'identite (email, mot de passe, MFA) appartient a Keycloak. Cette base ne
// porte que le profil de jeu et un miroir des revendications utiles hors
// session : le realm reste la source de verite.
//
// L'URL de connexion n'est plus declaree ici depuis Prisma 7 : prisma7.config.ts
// pour le CLI, l'adaptateur pg de l'api a l'execution, tous deux sur
// POSTGRES_URL. Le client est genere dans src/ parce que le generateur emet du
// TypeScript : ailleurs, il sortirait du rootDir du build.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Doit suivre UiLocale de @odyssai/schemas, qui borne la meme liste cote HTTP.
enum Locale {
  fr
  en

  @@map("locale")
}

/// Un joueur. La ligne nait au premier retour de Keycloak, pas a l'inscription :
/// le realm sert ses propres pages et l'API ne voit le joueur qu'au callback.
model User {
  /// UUIDv7, donc ordonne dans le temps : les insertions restent groupees en
  /// fin d'index.
  id String @id @default(uuid(7)) @db.Uuid

  /// Revendication `sub` de l'id_token, seul lien entre une session et cette
  /// ligne. Pas de @db.Uuid : Keycloak prefixe les utilisateurs federes
  /// (`f:<storage>:<id>`).
  keycloakId String @unique @map("keycloak_id")

  /// Miroir du realm, rafraichi a chaque connexion. Indexe mais pas unique :
  /// l'unicite appartient a Keycloak, et une copie obsolete ne doit pas
  /// refuser la connexion de celui qui a repris l'adresse.
  email String

  emailVerified Boolean @default(false) @map("email_verified")

  /// Choisi apres la premiere connexion, il n'existe pas dans le realm. NULL
  /// n'entre pas dans la contrainte d'unicite en Postgres.
  username String? @unique @db.VarChar(32)

  /// Le meme, en minuscules. Sans lui, Nyx et nyx coexisteraient, et le pseudo
  /// etant affiche aux autres joueurs l'usurpation serait triviale. Colonne
  /// plutot qu'index fonctionnel : Prisma ne sait pas modeliser le second et
  /// proposerait de le supprimer a la migration suivante. Ecrit par
  /// UsersService, jamais a la main. Les diacritiques ne sont pas replies :
  /// Elise et Elise sans accent restent deux pseudos distincts. Plus large que
  /// username : quelques majuscules Unicode s'abaissent en deux points de code,
  /// et la colonne rejetterait la valeur repliee.
  usernameFolded String? @unique @map("username_folded") @db.VarChar(64)

  /// Decide ici et non par un role du realm : le realm authentifie,
  /// l'application decide qui est maitre du jeu.
  isAdmin Boolean @default(false) @map("is_admin")

  /// Consentement a recevoir des nouvelles. Faux par defaut : un opt-in
  /// pre-coche n'est pas un consentement.
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")

  /// L'instant du dernier changement, dans les deux sens. Un consentement se
  /// prouve, et prouver demande une date ; un retrait se montre aussi bien.
  marketingOptInAt DateTime? @map("marketing_opt_in_at") @db.Timestamptz(3)

  /// Renvoyee a Keycloak au prochain signin.
  locale Locale @default(fr)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  universe     Universe?
  encounters   Encounter[]
  llmUsage     LlmUsage[]
  subscription Subscription?

  @@index([email])
  @@map("users")
}

/// D'ou vient la reponse servie. `error` n'existe pas dans le contrat partage
/// avec le web : une panne n'est pas une source, c'est un evenement d'erreur.
enum GuideSource {
  faq
  llm
  off_topic
  degraded
  error

  @@map("guide_source")
}

/// Une question posee au guide. Ni adresse IP ni identifiant de joueur : le
/// journal sert a mesurer l'usage et le cout, pas a suivre un visiteur.
model GuideQuestion {
  id     String @id @default(uuid(7)) @db.Uuid
  locale Locale

  question       String
  /// Empreinte de la question normalisee, pour reperer les formulations qui
  /// reviennent et meritent une entree de FAQ.
  normalizedHash String @map("normalized_hash")

  source     GuideSource
  faqEntryId String?     @map("faq_entry_id")

  provider        String?
  model           String?
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  reasoningTokens Int?     @map("reasoning_tokens")
  costUsd         Decimal? @map("cost_usd") @db.Decimal(10, 6)

  /// N'est plus ecrite : le tracing d'execution est diffuse par OpenRouter,
  /// qui trace tout, et l'echantillonnage n'existe plus. Gardee un
  /// deploiement, le temps que l'ancienne image cesse de tourner, puis a
  /// supprimer : une colonne se retire en deux fois, jamais dans celui qui
  /// cesse de l'ecrire.
  traced Boolean @default(false)

  /// Uniquement pour les reponses generees, jamais pour les textes fixes.
  answer String?

  promptVersion String @map("prompt_version")
  corpusVersion String @map("corpus_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([normalizedHash])
  @@map("guide_questions")
}

/// Ou en est le joueur dans son entree en jeu. L'etape du pseudo n'y figure
/// pas : elle se deduit de users.username, et la stocker ici en ferait une
/// seconde verite qui finirait par contredire la premiere.
enum OnboardingStep {
  inspiration
  character
  generating
  ready
  failed

  @@map("onboarding_step")
}

/// Les deux facons de nourrir la generation, exclusives.
enum InspirationMode {
  /// Des oeuvres citees, converties en themes avant toute generation.
  works
  /// Un monde decrit par le joueur lui-meme.
  own

  @@map("inspiration_mode")
}

/// Un univers par joueur. Il nait des la premiere entree dans le parcours, bien
/// avant d'avoir un monde : c'est lui qui porte la reprise.
model Universe {
  id String @id @default(uuid(7)) @db.Uuid

  /// Nullable : un monde deja visite par d'autres joueurs survit au depart de
  /// celui qui l'a fait naitre, detache de lui. NULL n'entre pas dans la
  /// contrainte d'unicite en Postgres, donc plusieurs mondes orphelins
  /// cohabitent sans se gener.
  ///
  /// SetNull et non Cascade : c'est le service d'effacement qui decide du sort
  /// d'un monde, pas la base. Contrepartie assumee, supprimer un utilisateur a
  /// la main laisse desormais son monde orphelin au lieu de l'emporter.
  ownerId String? @unique @map("owner_id") @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  step OnboardingStep @default(inspiration)

  mode InspirationMode?

  /// Les oeuvres citees, telles que saisies. Conservees pour la reprise, mais
  /// elles ne quittent jamais la passe d'abstraction : la generation ne voit
  /// que `themes`. Cinq au plus, borne par le schema Zod partage.
  works String[] @default([])

  /// Le monde decrit par le joueur, quand il choisit ce mode.
  ownDescription String? @map("own_description")

  /// Sortie de la passe d'abstraction : des themes sans aucun nom propre.
  /// C'est la seule chose que les etapes suivantes recoivent.
  themes Json?

  /// Ce qui existe ou non dans ce monde, le ton, les interdits. Le narrateur
  /// la respecte en toutes circonstances.
  charter Json?

  /// Le monde genere : lore, factions, politique, affinites. En JSON valide par
  /// Zod a l'ecriture comme a la lecture, plutot qu'en tables : les sortir
  /// demanderait de dessiner tout le schema du jeu.
  bible Json?

  name String? @db.VarChar(80)

  /// Teinte de l'accent, que l'interface applique en entrant dans ce monde.
  accentHue Int? @map("accent_hue")

  /// Ou en est l'histoire : 1, 2 ou 3 pendant l'arc, 4 une fois le troisieme
  /// acte clos. Le joueur continue alors ses propres aventures, et le monde
  /// s'ecrit au fil de l'eau. Nul pour un monde genere avant l'arc.
  arcAct Int? @map("arc_act")

  character  Character?
  messages   ConversationMessage[]
  jobs       GenerationJob[]
  encounters Encounter[]
  turns      Turn[]
  canon      CanonFact[]
  entities   Entity[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("universes")
}

/// Le personnage du joueur. Un seul par univers pour l'instant, d'ou l'unicite
/// sur universe_id : c'est celui qu'il incarne.
model Character {
  id String @id @default(uuid(7)) @db.Uuid

  /// Nullable : un personnage que d'autres joueurs ont rencontre survit a la
  /// suppression de son monde. C'est le SetNull qui le protege de la cascade,
  /// sans dependre d'un ordre d'ecriture.
  universeId String?   @unique @map("universe_id") @db.Uuid
  universe   Universe? @relation(fields: [universeId], references: [id], onDelete: SetNull)

  /// Nullable parce que la fiche s'ecrit en plusieurs fois : la presence du
  /// nom est exigee par le schema strict au moment de lancer la generation,
  /// pas par la table, qui doit pouvoir porter un brouillon.
  name String? @db.VarChar(60)

  /// Texte borne par le schema Zod plutot qu'enum : le vocabulaire du genre
  /// n'a pas a etre fige par une migration.
  gender String? @db.VarChar(40)
  age    Int?

  /// Traits choisis et texte libre, puis le socle chiffre. Le modele propose,
  /// le schema tranche, le joueur corrige.
  personality Json?
  attributes  Json?

  /// Ce que le personnage sait faire, nomme librement : « Kendo », « lire le
  /// vent ». La couleur, la ou les attributs sont le calcul. Le moteur ne les
  /// lit pas, le meneur si.
  talents String[] @default([])

  /// Ce que le personnage porte. Des noms, sans effet chiffre : le meneur les
  /// raconte, le moteur ne les calcule pas.
  inventory String[] @default([])

  /// Jets depuis la derniere montee, un compteur par attribut. Remis a zero au
  /// palier franchi : sans lui il faudrait rejouer toute l'histoire pour
  /// savoir ou en est un personnage.
  progress Json?

  /// La tombe. Non nul, le personnage a ete rencontre par d'autres avant que
  /// son joueur ne parte : on le garde pour que les recits qui l'ont croise
  /// puissent le dire mort, au lieu de le faire disparaitre de leur memoire.
  diedAt DateTime? @map("died_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  encounters Encounter[]

  @@map("characters")
}

/// L'abonnement d'un joueur, et sa reserve de credits.
///
/// `credits` est denormalise a cote du grand livre : un solde se lit a chaque
/// tour, et le recalculer par une somme a chaque fois couterait une agregation
/// sur une table qui ne fait que grandir. Les deux s'ecrivent toujours dans la
/// meme transaction, donc ils ne peuvent pas diverger.
/// Un palier d'abonnement, editable depuis le tableau de bord d'administration.
///
/// Les plans vivaient en code, leurs prix chez Stripe. Ils passent en base
/// parce qu'une dotation ne doit pas demander un deploiement pour bouger.
/// L'objection d'origine (une table rendrait la base propre a un
/// environnement) ne tient pas : les deux copies du site ont deja leur propre
/// Postgres, et un prix du mode test n'a de sens que dans la base de dev.
/**
 * Un message du formulaire de contact.
 *
 * Ecrit avant l'envoi du courriel : un serveur de messagerie qui refuse ne
 * doit pas faire perdre le message de quelqu'un qui a pris le temps de
 * l'ecrire. Sans relation vers `users` : le formulaire est ouvert a qui n'a
 * pas de compte, et c'est souvent lui qui a le plus besoin d'ecrire.
 */
model ContactMessage {
  id String @id @default(uuid(7)) @db.Uuid

  name    String? @db.VarChar(80)
  email   String  @db.VarChar(254)
  subject String  @db.VarChar(120)
  message String

  /// Faux quand l'envoi a echoue. Le message reste lisible au tableau de bord.
  delivered Boolean @default(false)

  /// Pose quand l'administrateur l'a marque traite.
  handledAt DateTime? @map("handled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([handledAt, createdAt(sort: Desc)])
  @@map("contact_messages")
}

/**
 * Les reglages du site, en une seule ligne.
 *
 * `id` vaut toujours vrai : une contrainte de verification empeche la seconde
 * ligne, donc personne n'aura a se demander laquelle fait foi. Ce qui vit ici
 * se decide un matin et doit s'appliquer le matin meme, sans deploiement.
 */
model SiteSettings {
  id Boolean @id @default(true)

  /// `preregistration` ou `open`. « Complete » n'est pas une phase : c'est le
  /// constat que les places sont prises, et il se lit dans `users`.
  alphaPhase String @default("preregistration") @map("alpha_phase") @db.VarChar(16)

  /// Faux pour taire l'annonce sans changer la phase.
  alphaNotice Boolean @default(true) @map("alpha_notice")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

model Plan {
  id String @id @default(uuid(7)) @db.Uuid

  /// Ce que `subscriptions.plan` porte, et ce qui voyage dans les contrats
  /// HTTP. Jamais l'uuid : un identifiant lisible se relit dans un journal.
  slug String @unique @db.VarChar(24)

  /// Affiche au joueur. Le slug est technique, celui-ci ne l'est pas.
  name String @db.VarChar(64)

  /// Credits rendus a chaque periode.
  monthlyCredits Int @map("monthly_credits")

  /// Accorde une seule fois, a l'ouverture du compte. Couvre la generation du
  /// premier monde sur le palier libre.
  welcomeCredits Int @default(0) @map("welcome_credits")

  /// Ce que Stripe facture, en centimes. Copie pour l'affichage et pour
  /// l'historique : la verite du montant reste le prix Stripe, immuable.
  /// NULL pour un palier gratuit, qui n'a pas de prix.
  amountCents Int?   @map("amount_cents")
  currency    String @default("eur") @db.VarChar(3)

  /// Vides tant que le plan n'est pas en vente. Un prix Stripe est immuable :
  /// changer le montant en cree un nouveau et archive l'ancien, ce que le
  /// tableau de bord fait pour nous.
  stripeProductId String? @map("stripe_product_id")
  stripePriceId   String? @unique @map("stripe_price_id")

  /// Archive plutot que supprime des qu'un abonne l'a porte : le grand livre
  /// doit rester lisible, et un plan retire de la vente reste servi jusqu'a
  /// la fin de la periode payee.
  archived Boolean @default(false)

  /// Le palier mis en avant sur la page de tarifs. Un index partiel unique
  /// n'en laisse qu'un a la fois : deux ecritures concurrentes passeraient si
  /// la regle ne vivait que dans le service.
  recommended Boolean @default(false)

  /// Annonce sans vendre. Un palier archive disparait, celui-ci s'affiche et
  /// dit qu'il arrive. A distinguer d'un palier sans prix Stripe, qui n'est
  /// pas vendable faute de configuration : ici c'est une decision.
  comingSoon Boolean @default(false) @map("coming_soon")

  /// L'ordre d'affichage, choisi a la main : ni le prix ni la dotation ne
  /// donnent l'ordre voulu quand un plan est offert.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@index([archived, sortOrder])
  @@map("plans")
}

model Subscription {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Le slug du palier, et non son uuid : c'est lui qui voyage dans les
  /// contrats HTTP et se relit dans un journal. La cle etrangere empeche de
  /// supprimer un plan que quelqu'un porte encore.
  plan    String @default("free") @db.VarChar(24)
  planRef Plan   @relation(fields: [plan], references: [slug], onUpdate: Cascade)

  status String @default("active") @db.VarChar(24)

  credits Int @default(0)

  /// L'ancre du renouvellement. Vient de la facture pour un abonnement paye,
  /// de la creation du compte pour le palier libre : un abonne du 20 ne doit
  /// pas voir sa reserve repartir le 1er.
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)

  /// Accorde une seule fois, a l'ouverture du compte.
  welcomed Boolean @default(false)

  /// `users.email` n'est pas unique : c'est l'identifiant Stripe qui fait le
  /// lien, jamais l'adresse.
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  cancelAtPeriodEnd    Boolean @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries CreditEntry[]

  @@map("subscriptions")
}

/// Le grand livre des credits. En ajout seul : on ne corrige pas une ecriture
/// comptable, on en passe une autre.
model CreditEntry {
  id             String       @id @default(uuid(7)) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Negatif pour un debit, positif pour une attribution ou un remboursement.
  delta Int

  /// grant, welcome, founder, turn, character, world, refund, adjustment.
  reason String @db.VarChar(24)

  /// Ce a quoi l'ecriture se rattache : un univers, un tour, une facture.
  ref String?

  /// Le solde apres l'ecriture, fige. Relire le grand livre des annees plus
  /// tard doit donner ce que le joueur a vu, meme si le bareme a change.
  balance Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subscriptionId, createdAt])
  @@map("credit_entries")
}

/// Les evenements Stripe deja traites.
///
/// C'est toute l'idempotence : Stripe rejoue ses webhooks jusqu'a obtenir un
/// 2xx, et un `invoice.paid` traite deux fois crediterait deux fois.
model StripeEvent {
  /// L'identifiant rendu par Stripe, et non un uuid : c'est lui la cle.
  id String @id

  type      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

/// Ce que chaque appel de modele a coute, quel qu'il soit.
///
/// Cinq des huit points d'appel jetaient leur usage, dont la generation d'un
/// monde, qui en fait sept a vingt-trois. La donnee existait deja dans
/// narrator, personne ne la lisait. Sans ce journal, un plan d'abonnement est
/// une opinion : on ne peut pas tarifer ce qu'on ne mesure pas.
///
/// `guide_questions` garde son propre journal et reste anonyme : il n'a pas de
/// joueur a rattacher, et c'est voulu.
model LlmUsage {
  id String @id @default(uuid(7)) @db.Uuid

  /// SetNull plutot que Cascade : la comptabilite survit au depart du joueur,
  /// detachee de lui. Ce qui reste est un cout, plus une personne.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  universeId String? @map("universe_id") @db.Uuid

  /// Le point d'appel : turn, moderation, embedding, character, extract,
  /// abstraction, generation.
  kind String @db.VarChar(24)

  provider String @db.VarChar(16)
  model    String

  inputTokens     Int  @map("input_tokens")
  outputTokens    Int  @map("output_tokens")
  /// Factures au tarif de sortie chez les deux fournisseurs.
  reasoningTokens Int? @map("reasoning_tokens")

  /// Jetons d'entree servis depuis le cache du fournisseur. Le seul temoin
  /// qu'un cache de prompt sert vraiment : sans lui, choisir un fournisseur
  /// pour son cache serait une reputation.
  cachedTokens Int? @map("cached_tokens")

  /// Rendu par OpenRouter, calcule sinon. Decimal et non Float : un cout
  /// s'additionne sur des milliers de lignes, et le binaire y derive.
  costUsd Decimal? @map("cost_usd") @db.Decimal(12, 8)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("llm_usage")
}

/// Trace d'un croisement : un joueur a visite un univers, et parfois y a
/// rencontre son personnage.
///
/// Rien n'y ecrit encore, la traversee entre univers restant a construire. La
/// table existe des maintenant parce que c'est elle qui decide du sort d'un
/// monde et d'un personnage quand leur joueur s'en va : sans elle, il faudrait
/// deviner plus tard lesquels auraient du etre gardes.
model Encounter {
  id String @id @default(uuid(7)) @db.Uuid

  visitorId String @map("visitor_id") @db.Uuid
  visitor   User   @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  /// L'univers OU la rencontre a eu lieu, et non celui d'ou vient le
  /// personnage. Quand un personnage voyage, c'est le monde d'accueil qui est
  /// enregistre : son monde d'origine, lui, n'a recu personne. C'est ce qui
  /// rend les deux questions reellement independantes.
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  /// Nul quand le visiteur n'a fait que traverser le monde sans croiser son
  /// habitant.
  characterId String?    @map("character_id") @db.Uuid
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([universeId, visitorId])
  @@index([characterId, visitorId])
  @@map("encounters")
}

/// Ce qui distingue la creation de personnage du tour de jeu a venir. Les deux
/// vivent dans la meme table : le chat du jeu lira exactement la meme chose.
enum ConversationChannel {
  character_creation
  game_turn

  @@map("conversation_channel")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}

model ConversationMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  channel ConversationChannel
  role    MessageRole
  content String

  /// Rang explicite dans son canal. L'ordre d'un journal de partie ne peut pas
  /// dependre d'une horloge a la milliseconde : le message du joueur et la
  /// reponse du meneur s'ecrivent dans la meme transaction, et rien ne les
  /// departagerait. Le defaut a zero n'a servi qu'a poser la colonne, les
  /// conversations anterieures ayant ete renumerotees par la migration :
  /// **tout ecrivain pose son rang**, sans quoi le deuxieme message d'un
  /// canal tombe sur l'unicite.
  seq Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([universeId, channel, seq])
  @@index([universeId, channel, createdAt])
  @@map("conversation_messages")
}

/// Ce que le code a decide a un tour, a cote de ce qui s'y est dit, comme
/// `guide_questions` vit a cote des reponses du guide.
///
/// Le jet y est conserve alors que le joueur ne le verra jamais : c'est ce qui
/// permet de verifier apres coup qu'un de n'etait pas truque, et de diagnostiquer
/// un tour qui a mal tourne.
model Turn {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  /// Le rang du message du joueur qui a ouvert ce tour.
  seq Int

  /// Ce que le joueur a envoye : say, ask, fate, roll, open. `kind`, lui, est
  /// ce que le modele en a fait. Sans cette colonne, rien ne disait si une
  /// question etait passee par le bon chemin.
  request String? @db.VarChar(8)

  /// Le jet brut, de 1 a 20, et la bande qu'il donne. Le modele n'a recu que
  /// la bande.
  die  Int
  band String @db.VarChar(20)

  /// Ce que la fiche a ajoute ou retire au jet, et l'attribut sollicite.
  /// Gardes pour la meme raison que le jet brut : le score evolue en cours de
  /// partie, donc le modificateur ne se recalcule pas apres coup.
  modifier  Int     @default(0)
  attribute String? @db.VarChar(16)

  /// Vrai si le meneur a dit s'en etre servi : une question sur le monde ne se
  /// tranche pas au de, et le jet reste alors sans effet.
  usedDie Boolean @default(false) @map("used_die")

  kind String @db.VarChar(16)

  /// Faits entres au canon a ce tour.
  learned Int @default(0)

  /// Ce que le classificateur a lu dans le message du joueur. Nul quand il n'a
  /// rien reconnu, quand il n'a pas repondu, ou quand le tour n'a pas de
  /// message : une ouverture et un appel au sort n'en portent jamais.
  situation String? @db.VarChar(24)

  /// Les fiches de maitrise rappelees au meneur, par identifiant. Gardees pour
  /// la meme raison que le jet du de : verifier apres coup ce que le modele a
  /// reellement recu, et mesurer a quelle frequence le rappel se declenche.
  guidance String[] @default([])

  provider     String?
  model        String?
  inputTokens  Int?    @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  costUsd      Float?  @map("cost_usd")

  /// Metadonnee `turn_id` cote LangSmith, pour retrouver la trace.
  traceId String? @map("trace_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([universeId, seq])
  @@map("turns")
}

/// Ce que le meneur a invente en repondant a une question que le lore ne
/// couvrait pas. Une fois ecrit, c'est vrai pour toujours : le canon nourrit
/// tous les tours suivants.
model CanonFact {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  subject   String @db.VarChar(80)
  statement String @db.VarChar(400)

  /// Le tour qui l'a fait naitre.
  seq Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([universeId, createdAt])
  @@map("canon_facts")
}

/// Ce que le monde sait d'une personne, d'un objet, d'un lieu ou d'une
/// faction, en deux parts : `known`, ce que le joueur a appris, et `hidden`,
/// ce que le meneur garde jusqu'a ce que le jeu le revele. Semees par la
/// generation, puis nees de chaque nom que le meneur pose en jeu.
model Entity {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  /// npc, item, place, faction.
  kind String @db.VarChar(8)
  name String @db.VarChar(80)

  /// Le nom replie, pour l'unicite : le meneur ecrit « l'Epee » la ou il
  /// avait ecrit « epee corrompue ».
  key String @db.VarChar(80)

  known  String
  hidden String?

  revealedAt DateTime? @map("revealed_at") @db.Timestamptz(3)

  /// Le tour qui l'a fait naitre ; nul pour ce que la generation a seme.
  seq Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([universeId, key])
  @@map("entities")
}

enum GenerationStatus {
  queued
  running
  done
  failed

  @@map("generation_status")
}

/// Les noeuds du graphe, dans l'ordre. `step` dit ou en est la generation, ce
/// qui sert autant a l'ecran d'attente qu'au diagnostic.
enum GenerationStep {
  abstraction
  charter
  lore
  factions
  politics
  characters
  affinities
  arc
  validation

  @@map("generation_step")
}

/// Une ligne par generation. BullMQ suit le travail dans Redis ; cette table le
/// rend interrogeable, et garde l'identifiant de trace pour retrouver l'appel
/// dans LangSmith quand une generation tourne mal.
model GenerationJob {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  status   GenerationStatus @default(queued)
  step     GenerationStep?
  attempts Int              @default(0)

  /// Message d'erreur borne : de quoi diagnostiquer, jamais un prompt entier
  /// ni une cle.
  error String? @db.VarChar(500)

  /// Metadonnee `generation_job_id` cote LangSmith, pour retrouver la trace.
  traceId String? @map("trace_id")

  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([universeId, createdAt])
  @@map("generation_jobs")
}
