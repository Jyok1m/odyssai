// Schema de la base applicative.
//
// L'identite (email, mot de passe, MFA) appartient a Keycloak. Cette base ne
// porte que le profil de jeu et un miroir des revendications utiles hors
// session : le realm reste la source de verite.
//
// L'URL de connexion n'est plus declaree ici depuis Prisma 7 : prisma7.config.ts
// pour le CLI, l'adaptateur pg de l'api a l'execution, tous deux sur
// POSTGRES_URL. Le client est genere dans src/ parce que le generateur emet du
// TypeScript : ailleurs, il sortirait du rootDir du build.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Doit suivre UiLocale de @odyssai/schemas, qui borne la meme liste cote HTTP.
enum Locale {
  fr
  en

  @@map("locale")
}

/// Un joueur. La ligne nait au premier retour de Keycloak, pas a l'inscription :
/// le realm sert ses propres pages et l'API ne voit le joueur qu'au callback.
model User {
  /// UUIDv7, donc ordonne dans le temps : les insertions restent groupees en
  /// fin d'index.
  id String @id @default(uuid(7)) @db.Uuid

  /// Revendication `sub` de l'id_token, seul lien entre une session et cette
  /// ligne. Pas de @db.Uuid : Keycloak prefixe les utilisateurs federes
  /// (`f:<storage>:<id>`).
  keycloakId String @unique @map("keycloak_id")

  /// Miroir du realm, rafraichi a chaque connexion. Indexe mais pas unique :
  /// l'unicite appartient a Keycloak, et une copie obsolete ne doit pas
  /// refuser la connexion de celui qui a repris l'adresse.
  email String

  emailVerified Boolean @default(false) @map("email_verified")

  /// Choisi apres la premiere connexion, il n'existe pas dans le realm. NULL
  /// n'entre pas dans la contrainte d'unicite en Postgres.
  username String? @unique @db.VarChar(32)

  /// Le meme, en minuscules. Sans lui, Nyx et nyx coexisteraient, et le pseudo
  /// etant affiche aux autres joueurs l'usurpation serait triviale. Colonne
  /// plutot qu'index fonctionnel : Prisma ne sait pas modeliser le second et
  /// proposerait de le supprimer a la migration suivante. Ecrit par
  /// UsersService, jamais a la main. Les diacritiques ne sont pas replies :
  /// Elise et Elise sans accent restent deux pseudos distincts. Plus large que
  /// username : quelques majuscules Unicode s'abaissent en deux points de code,
  /// et la colonne rejetterait la valeur repliee.
  usernameFolded String? @unique @map("username_folded") @db.VarChar(64)

  /// Decide ici et non par un role du realm : le realm authentifie,
  /// l'application decide qui est maitre du jeu.
  isAdmin Boolean @default(false) @map("is_admin")

  /// Renvoyee a Keycloak au prochain signin.
  locale Locale @default(fr)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  universe Universe?

  @@index([email])
  @@map("users")
}

/// D'ou vient la reponse servie. `error` n'existe pas dans le contrat partage
/// avec le web : une panne n'est pas une source, c'est un evenement d'erreur.
enum GuideSource {
  faq
  llm
  off_topic
  degraded
  error

  @@map("guide_source")
}

/// Une question posee au guide. Ni adresse IP ni identifiant de joueur : le
/// journal sert a mesurer l'usage et le cout, pas a suivre un visiteur.
model GuideQuestion {
  id     String @id @default(uuid(7)) @db.Uuid
  locale Locale

  question String
  /// Empreinte de la question normalisee, pour reperer les formulations qui
  /// reviennent et meritent une entree de FAQ.
  normalizedHash String @map("normalized_hash")

  source     GuideSource
  faqEntryId String?     @map("faq_entry_id")

  provider        String?
  model           String?
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  reasoningTokens Int?     @map("reasoning_tokens")
  costUsd         Decimal? @map("cost_usd") @db.Decimal(10, 6)

  /// Vrai si la requete a ete echantillonnee : la trace se retrouve dans
  /// LangSmith par la metadonnee guide_question_id.
  traced Boolean @default(false)

  /// Uniquement pour les reponses generees, jamais pour les textes fixes.
  answer String?

  promptVersion String @map("prompt_version")
  corpusVersion String @map("corpus_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([normalizedHash])
  @@map("guide_questions")
}

/// Ou en est le joueur dans son entree en jeu. L'etape du pseudo n'y figure
/// pas : elle se deduit de users.username, et la stocker ici en ferait une
/// seconde verite qui finirait par contredire la premiere.
enum OnboardingStep {
  inspiration
  character
  generating
  ready
  failed

  @@map("onboarding_step")
}

/// Les deux facons de nourrir la generation, exclusives.
enum InspirationMode {
  /// Des oeuvres citees, converties en themes avant toute generation.
  works
  /// Un monde decrit par le joueur lui-meme.
  own

  @@map("inspiration_mode")
}

/// Un univers par joueur. Il nait des la premiere entree dans le parcours, bien
/// avant d'avoir un monde : c'est lui qui porte la reprise.
model Universe {
  id      String @id @default(uuid(7)) @db.Uuid
  ownerId String @unique @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  step OnboardingStep @default(inspiration)

  mode InspirationMode?

  /// Les oeuvres citees, telles que saisies. Conservees pour la reprise, mais
  /// elles ne quittent jamais la passe d'abstraction : la generation ne voit
  /// que `themes`. Cinq au plus, borne par le schema Zod partage.
  works String[] @default([])

  /// Le monde decrit par le joueur, quand il choisit ce mode.
  ownDescription String? @map("own_description")

  /// Sortie de la passe d'abstraction : des themes sans aucun nom propre.
  /// C'est la seule chose que les etapes suivantes recoivent.
  themes Json?

  /// Ce qui existe ou non dans ce monde, le ton, les interdits. Le narrateur
  /// la respecte en toutes circonstances.
  charter Json?

  /// Le monde genere : lore, factions, politique, affinites. En JSON valide par
  /// Zod a l'ecriture comme a la lecture, plutot qu'en tables : les sortir
  /// demanderait de dessiner tout le schema du jeu.
  bible Json?

  name String? @db.VarChar(80)

  /// Teinte de l'accent, que l'interface applique en entrant dans ce monde.
  accentHue Int? @map("accent_hue")

  character Character?
  messages  ConversationMessage[]
  jobs      GenerationJob[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("universes")
}

/// Le personnage du joueur. Un seul par univers pour l'instant, d'ou l'unicite
/// sur universe_id : c'est celui qu'il incarne.
model Character {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @unique @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  name String @db.VarChar(60)

  /// Texte borne par le schema Zod plutot qu'enum : le vocabulaire du genre
  /// n'a pas a etre fige par une migration.
  gender String? @db.VarChar(40)
  age    Int?

  /// Traits choisis et texte libre, puis attributs chiffres. Le modele propose,
  /// le schema tranche, le joueur corrige.
  personality Json?
  attributes  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("characters")
}

/// Ce qui distingue la creation de personnage du tour de jeu a venir. Les deux
/// vivent dans la meme table : le chat du jeu lira exactement la meme chose.
enum ConversationChannel {
  character_creation
  game_turn

  @@map("conversation_channel")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}

model ConversationMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  channel ConversationChannel
  role    MessageRole
  content String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([universeId, channel, createdAt])
  @@map("conversation_messages")
}

enum GenerationStatus {
  queued
  running
  done
  failed

  @@map("generation_status")
}

/// Les noeuds du graphe, dans l'ordre. `step` dit ou en est la generation, ce
/// qui sert autant a l'ecran d'attente qu'au diagnostic.
enum GenerationStep {
  abstraction
  charter
  lore
  factions
  politics
  characters
  affinities
  validation

  @@map("generation_step")
}

/// Une ligne par generation. BullMQ suit le travail dans Redis ; cette table le
/// rend interrogeable, et garde l'identifiant de trace pour retrouver l'appel
/// dans LangSmith quand une generation tourne mal.
model GenerationJob {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  status   GenerationStatus @default(queued)
  step     GenerationStep?
  attempts Int              @default(0)

  /// Message d'erreur borne : de quoi diagnostiquer, jamais un prompt entier
  /// ni une cle.
  error String? @db.VarChar(500)

  /// Metadonnee `generation_job_id` cote LangSmith, pour retrouver la trace.
  traceId String? @map("trace_id")

  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([universeId, createdAt])
  @@map("generation_jobs")
}
