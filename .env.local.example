# Copier en .env.local et renseigner. Ignore par git.
#
# Lu par le Makefile seul, qui source ce fichier dans le shell de la recette.
# Une valeur contenant une espace, un # ou un $ doit donc etre entre guillemets
# simples ; un chemin commencant par ~ doit au contraire rester sans guillemets
# pour etre etendu.

# Serveur de developpement, celui qui heberge le Redis de dev.
SSH_HOST=
SSH_PORT=
SSH_KEY_FILE=

# Ports du tunnel ouvert par `make tunnel`. Le distant est celui que le
# serveur publie sur sa boucle locale, le local celui que reprend REDIS_URL.
REDIS_LOCAL_PORT=16379
REDIS_REMOTE_PORT=16379
