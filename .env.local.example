# Copier en .env.local et renseigner. Ignore par git.
#
# Lu par le Makefile, qui source ce fichier dans le shell de la recette. Deux
# consequences :
#   - une valeur contenant une espace, un # ou un $ doit etre entre guillemets
#     simples, sinon le shell l'interprete ; le chargement s'arrete alors net
#     plutot que de continuer avec une variable tronquee ;
#   - un chemin commencant par ~ doit rester sans guillemets pour etre etendu.
#
# KC_SA_* porte les identifiants d'administration Keycloak, et KC_SA_KIND dit
# de quelle nature ils sont :
#   user   (defaut) un compte du realm master, authentifie par direct grant.
#          Ce compte ne doit pas porter de MFA, le direct grant ne sait pas
#          presenter un second facteur.
#   client un service account, soit l'identifiant d'un client confidentiel de
#          master et son secret. A privilegier quand il existera.

# Administration KC
KC_SA_KIND=client
KC_SA_USERNAME=
KC_SA_PASSWORD=

# Server Info
SSH_HOST=
SSH_PORT=
SSH_KEY_FILE=

# Redis Info
REDIS_LOCAL_PORT=
REDIS_REMOTE_PORT=
# SMTP du realm Keycloak. SMTP_HOST est la variable pivot : renseignee, le
# realm envoie les courriels, la verification d adresse est activee et le mot
# de passe oublie devient utilisable. Vide, verifyEmail reste a false, sinon un
# compte non verifie ne pourrait plus se connecter et rien ne le debloquerait.
#
# SMTP_FROM doit appartenir a un domaine que le serveur de mail est autorise a
# signer, sinon SPF et DKIM echouent et le message part en indesirable.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_USER=
SMTP_PASSWORD=
