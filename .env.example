# Copier en .env et renseigner. Ignore par git.
#
# Lu par apps/api, qui remonte l'arborescence depuis son repertoire de travail
# pour le trouver : un seul fichier a la racine suffit. Next ne lit que le
# sien, voir apps/web/.env.example.

NODE_ENV=development
PORT=3001

# Origines publiques. Elles construisent la redirect_uri declaree dans
# Keycloak, autorisent CORS et decident si les cookies sont Secure.
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Keycloak. Le realm et ses clients sont decrits par le role ansible keycloak
# du depot iac-journey, seule source de verite. Le poste de developpement a son
# propre client, odyssai-api-local : un client ne porte qu'un seul baseUrl, et
# le partager avec la copie deployee renvoyait chaque connexion sur l'autre.
# Son secret se releve dans la console du realm.
KEYCLOAK_ISSUER=https://sso.joachimjasmin.com/realms/odyssai-dev
KEYCLOAK_CLIENT_ID=odyssai-api-local
KEYCLOAK_CLIENT_SECRET=

# Redis. Le serveur ne publie le Redis de dev que sur sa boucle locale :
# `make tunnel` ouvre le port local 16379, `make redis-ping` verifie qu'il
# repond vraiment.
REDIS_URL=redis://:mot-de-passe@localhost:16379

# Prefixe des cles BullMQ. `bull` par defaut, ce que les environnements
# deployes gardent. Sur un poste de developpement, un autre prefixe isole les
# travaux locaux du worker-dev du serveur, qui ecoute le meme Redis par le
# tunnel et les prendrait sinon avant le worker local.
BULLMQ_PREFIX=bull-local

# PostgreSQL
POSTGRES_URL=postgresql://user:mot-de-passe@127.0.0.1:15432/db

# Fournisseurs LLM
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# LangSmith (endpoint UE), pour les evaluations seules : le tracing d'execution
# est diffuse par OpenRouter vers la destination configuree chez lui (Broadcast).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Odyssai-Dev
# LANGSMITH_WORKSPACE_ID=   (seulement si la cle est liee a plusieurs workspaces)

# Guide : modele
LLM_GUIDE_PROVIDER=openrouter
LLM_GUIDE_MODEL=openai/gpt-5.6-luna
LLM_GUIDE_EXTRA_BODY='{"models":["qwen/qwen3.8-flash"],"reasoning":{"effort":"none"},"provider":{"data_collection":"deny"}}'
# Variante OpenAI en direct :
# LLM_GUIDE_PROVIDER=openai
# LLM_GUIDE_MODEL=gpt-5.6-luna
# LLM_GUIDE_EXTRA_BODY='{"reasoning_effort":"none"}'
LLM_GUIDE_TEMPERATURE=0.3
LLM_GUIDE_MAX_OUTPUT_TOKENS=350
# Prix du modele le plus cher de la chaine de fallback, sinon le budget se
# trompe a la baisse
LLM_GUIDE_PRICE_INPUT_USD_PER_MTOK=0.20
LLM_GUIDE_PRICE_OUTPUT_USD_PER_MTOK=1.20

# Narrateur et generation de monde. Le modele se choisit par evaluation :
# `pnpm --filter @odyssai/api eval:narration` compare les candidats sur la passe
# narration ne demarre pas, mais l'api si : aucune route ne la lit encore.
LLM_NARRATOR_PROVIDER=openrouter
# Les modeles vivent dans packages/llm/src/models.ts, un par role. Ceux-ci ne
# servent qu'a eval:narration, qui compare avant qu'on decide la-bas.
LLM_NARRATOR_CANDIDATES=qwen/qwen3.5-35b-a3b,qwen/qwen3.7-plus,qwen/qwen3-8b,thedrummer/skyfall-36b-v2,deepseek/deepseek-v4-flash-0731,inclusionai/ling-3.0-flash-vl:free,thedrummer/unslopnemo-12b
LLM_NARRATOR_EXTRA_BODY='{"reasoning":{"effort":"none"},"provider":{"data_collection":"deny"},"repetition_penalty":1.1}'
LLM_NARRATOR_PRICE_INPUT_USD_PER_MTOK=0
LLM_NARRATOR_PRICE_OUTPUT_USD_PER_MTOK=0
# Worker de generation. Un monde a la fois : chaque generation fait sept appels
# et dure des minutes, en lancer plusieurs de front allongerait les deux.
# Contrairement a l'api, le worker exige LLM_NARRATOR_MODEL pour demarrer.
WORKER_CONCURRENCY=1

# Guide : garde-fous
GUIDE_ENABLED=true
GUIDE_DAILY_BUDGET_USD=1
GUIDE_RATE_PER_HOUR=10
GUIDE_RATE_PER_DAY=30
GUIDE_MAX_CONCURRENT=5
GUIDE_PASS_QUESTIONS=10
GUIDE_PASS_TTL_SECONDS=3600
GUIDE_IP_HASH_SECRET=
GUIDE_LOG_RETENTION_DAYS=30
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TRUST_PROXY=false

# Le deploiement, et non la facon dont Node est bati. Les deux copies du site
# tournent avec NODE_ENV=production, l'image etant la meme : c'est cette
# variable qui dit laquelle des deux, et elle seule decide du mode Stripe.
ODYSSAI_ENV=development

# Stripe. Tout est facultatif : sans cle, la vente se tait et le palier libre
# suffit a jouer, ce qui permet de developper sans compte Stripe.
#
# Une cle sk_live_ est refusee au demarrage hors ODYSSAI_ENV=production, et une
# cle sk_test_ y est refusee : les deux sens du meme garde-fou.
# Le secret de webhook devient obligatoire des qu'une cle est presente, sans
# quoi aucune signature ne se verifierait.
#
# Aucun identifiant de prix ici : les paliers sont des lignes de la table
# `plans`, et le tableau de bord (/admin) cree lui-meme le produit et le prix
# chez Stripe quand on ajoute un palier paye.
#
# En developpement, le secret de webhook est celui qu'affiche :
#   stripe listen --forward-to localhost:3001/billing/webhook
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=

# Messagerie sortante, pour le formulaire de contact. Vide, les messages sont
# tout de meme enregistres en base et lisibles au tableau de bord : seul
# l'envoi est coupe.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
# Ou arrivent les messages du formulaire de contact.
SMTP_FROM_NAME="Message @ Odyssai"
CONTACT_TO=
