# Copier en .env et renseigner. Le fichier .env est ignore par git.
# apps/api remonte l'arborescence depuis son repertoire de travail pour le
# trouver, un seul fichier a la racine suffit donc pour tout le monorepo.

NODE_ENV=development
PORT=3001

# Origines publiques. Elles servent a construire la redirect_uri declaree
# dans Keycloak, a autoriser CORS et a decider si les cookies sont Secure.
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Keycloak. Ces trois valeurs sont imprimees par
#   KC_ADMIN_PASSWORD='...' ./infra/keycloak/setup-realm.sh odyssai-dev
KEYCLOAK_ISSUER=https://sso.joachimjasmin.com/realms/odyssai-dev
KEYCLOAK_CLIENT_ID=odyssai-api
KEYCLOAK_CLIENT_SECRET=

# Redis. Node n'interpole pas les variables dans un fichier .env : le meme
# secret doit etre ecrit en clair aux deux endroits. REDIS_PASSWORD est lu par
# compose.yaml, REDIS_URL par apps/api.
REDIS_PASSWORD=
REDIS_URL=redis://:le-meme-mot-de-passe@127.0.0.1:6379/0
