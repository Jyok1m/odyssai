{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
