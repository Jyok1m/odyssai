# Origine publique du site, sans slash final.
# Sert aux URLs canonical, hreflang, OpenGraph, sitemap et robots.txt.
# Lue côté serveur uniquement : pas de préfixe NEXT_PUBLIC_, la valeur ne
# part donc jamais dans le bundle navigateur.
#   prod : https://odyssai.app
#   dev  : https://dev.odyssai.app
# Non définie, tout retombe sur http://localhost:3000.
SITE_URL=https://odyssai.app
