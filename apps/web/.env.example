# Origine publique du site, sans slash final.
# Sert aux URLs canonical, hreflang, OpenGraph, sitemap et robots.txt.
# Lue côté serveur uniquement : pas de préfixe NEXT_PUBLIC_, la valeur ne
# part donc jamais dans le bundle navigateur.
#   prod : https://odyssai.app
#   dev  : https://dev.odyssai.app
# Non définie, tout retombe sur http://localhost:3000.
SITE_URL=https://odyssai.app

# Ouverture de l'alpha. Tant que ce n'est pas exactement "true", les appels
# à l'action « Se connecter » et « Créer mon univers » ouvrent un toast au
# lieu de naviguer. Préfixe NEXT_PUBLIC_ car le drapeau est lu côté
# navigateur : sa valeur est donc figée au build de l'image.
NEXT_PUBLIC_ALPHA_OPEN=false

# Origine publique de l'API, appelée depuis le navigateur : elle porte les
# redirections de connexion et la lecture de session. Préfixe NEXT_PUBLIC_ car
# la valeur est lue côté navigateur, elle est donc figée au build de l'image.
# L'API doit partager le domaine enregistrable du site : le cookie de session
# est SameSite=Lax et ne partirait pas vers un autre site.
#   prod : https://api.odyssai.app
#   dev  : http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
