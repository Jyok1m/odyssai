# Copier en .env et renseigner. Ignore par git.
#
# Lu par Next seul, qui ne regarde que le repertoire de son application. Ce
# qu'utilise apps/api est a la racine du monorepo, voir .env.example.
#
# NEXT_PUBLIC_ est fige au build de l'image : ces valeurs passent par un ARG du
# Dockerfile et lient l'image a son environnement. Les fournir a l'execution ne
# change rien.

# Origine publique du site, sans barre finale. Elle porte les canonical, les
# hreflang, OpenGraph, le sitemap et robots.txt. Sans prefixe NEXT_PUBLIC_ :
# elle n'est lue que cote serveur et ne part pas dans le bundle. Non definie,
# tout retombe sur http://localhost:3000.
#   prod : https://odyssai.app
#   dev  : https://dev.odyssai.app
SITE_URL=http://localhost:3000

# Ouverture de l'alpha. Tant que ce n'est pas exactement "true", les appels a
# l'action ouvrent un toast d'attente au lieu de naviguer.
NEXT_PUBLIC_ALPHA_OPEN=false

# Origine publique de l'API, appelee depuis le navigateur : elle porte les
# redirections de connexion et la lecture de session. Elle doit partager le
# domaine enregistrable du site, sinon le cookie de session, en SameSite=Lax,
# ne partirait pas.
#   prod : https://api.odyssai.app
#   dev  : http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
