        <mxCell id="jyg5pY-l2ygy7PSvqwre-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1D1C24;" value="&lt;b&gt;Modèle de données&lt;/b&gt; (PostgreSQL, Prisma 7)" vertex="1">
